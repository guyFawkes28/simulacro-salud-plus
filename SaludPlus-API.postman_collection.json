							"raw": "{{baseUrl}}/api/doctors/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "doctors", "1"]
						},
						"description": "Get a specific doctor by ID. Returns 404 if not found."
					},
					"response": []
				},
				{
					"name": "Update Doctor (Full)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dr. John M. Smith\",\n  \"email\": \"john.smith@newhospital.com\",\n  \"specialty\": \"Pediatric Cardiology\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "doctors", "1"]
						},
						"description": "Update doctor in PostgreSQL and propagate name/email changes to MongoDB patient histories"
					},
					"response": []
				},
				{
					"name": "Update Doctor (Partial - Name Only)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dr. Jane Updated\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors/2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "doctors", "2"]
						},
						"description": "Partial update - only update name field"
					},
					"response": []
				},
				{
					"name": "Update Doctor (Partial - Specialty Only)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"specialty\": \"Neurology\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors/3",
							"host": ["{{baseUrl}}"],
							"path": ["api", "doctors", "3"]
						},
						"description": "Partial update - only update specialty field"
					},
					"response": []
				}
			],
			"description": "Doctor management endpoints (CRUD operations)"
		},
