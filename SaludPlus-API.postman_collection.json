{
	"info": {
		"_postman_id": "saludplus-api-2026",
		"name": "SaludPlus API",
		"description": "Complete API collection for SaludPlus Healthcare Management System - Hybrid PostgreSQL + MongoDB",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "saludplus"
	},
	"item": [
		{
			"name": "Migration",
			"item": [
				{
					"name": "Get Migration Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/simulacro",
							"host": ["{{baseUrl}}"],
							"path": ["api", "simulacro"]
						},
						"description": "Get information about the migration endpoint"
					},
					"response": []
				},
				{
					"name": "Migrate Data (Clear Before)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clearBefore\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/simulacro/migrate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "simulacro", "migrate"]
						},
						"description": "Migrate CSV data to PostgreSQL and MongoDB. Clears existing data before migration."
					},
					"response": []
				},
				{
					"name": "Migrate Data (Append)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clearBefore\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/simulacro/migrate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "simulacro", "migrate"]
						},
						"description": "Migrate CSV data without clearing existing records (upsert mode)"
					},
					"response": []
				}
			],
			"description": "Endpoints for data migration from CSV to databases"
		},
		{
			"name": "Doctors",
			"item": [
				{
					"name": "Get All Doctors",
					"request": {
						"method": "GET",
						"header": [],
