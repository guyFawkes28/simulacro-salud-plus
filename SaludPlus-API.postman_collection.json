				{
					"name": "Get Doctors by Specialty",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/doctors?specialty=Cardiology",
							"host": ["{{baseUrl}}"],
							"path": ["api", "doctors"],
							"query": [
								{
									"key": "specialty",
									"value": "Cardiology",
									"description": "Filter by specialty (case-insensitive)"
								}
							]
						},
						"description": "Filter doctors by specialty"
					},
					"response": []
				},
				{
					"name": "Get Doctor by ID",
